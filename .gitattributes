# TheOracle vectors are not in git at all since 2026-10-25 (Gaffer's option A1): a rebuild stored a whole new
# 53 MB LFS object every time. They live in the private data folder with the rest of the index (docs/data.md).
# PNGs are stored as LFS pointers; the standalone repo needs this rule, since the monorepo root .gitattributes is not exported.
*.png filter=lfs diff=lfs merge=lfs -text
# Video and WebP media go through LFS from 2026-10-17 (tech-debt row 36); older versions stay in plain history.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
# The commit hooks are shell scripts: they keep LF line endings on every platform.
/.githooks/* text eol=lf
