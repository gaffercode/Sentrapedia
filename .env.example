# Unified launcher starts the bundled AADI engine and generates its private URL/token.
# AADI calls the Gemini API directly (gemini-3.1-flash-lite, scripts/aadi-profile.json). Server-side key only;
# use a paid-tier key: Google may use free-tier prompts to improve its products.
GEMINI_API_KEY=

# Do not set AADI_SERVICE_URL or AADI_SERVICE_TOKEN here: `npm run dev` generates both on every start, and
# stale values make `npx next dev` call an engine that is not running (HTTP 502).
# Optional local listener: PORT (default 3101) and SENTRAPEDIA_HOST (default 127.0.0.1).

# Clerk owns closed-beta invitations, verification and sessions. Use separate dev/prod instances.
# Set both keys securely; never commit a filled environment file. Only the publishable key is public.
SENTRAPEDIA_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook (Dashboard > Webhooks > endpoint https://<public origin>/api/webhooks/clerk, event user.deleted): a closed
# account's rows in Neon are deleted with it. Optional; without it the route answers 503 and nothing is purged.
# CLERK_WEBHOOK_SIGNING_SECRET=
# Production requires matching live keys plus the exact HTTPS origin below. Missing config denies access.
# Local-only development without Clerk: SENTRAPEDIA_AUTH_MODE=local with NODE_ENV=development,
# SENTRAPEDIA_HOST=127.0.0.1 and no SENTRAPEDIA_PUBLIC_ORIGIN. Never use with a tunnel/public listener.

# Targeted therapy runs by default; set false to use the legacy single-step path.
# AADI_TARGETED_THERAPY=false

# Closed beta only (behind Cloudflare Tunnel and Access; never expose the port directly).
# SENTRAPEDIA_PUBLIC_ORIGIN=https://beta.sentrapedia.com
# Analyses that may run at the same time, 1-8 (default 1). Each still reserves its step cap from the daily budget.
# AADI_MAX_CONCURRENT=3

# Server-side workspace sync (optional; absent or SENTRAPEDIA_SYNC_MODE=off keeps the browser authoritative).
# Connect as the non-owner runtime role, never Neon's owner role: that role carries BYPASSRLS and would skip
# every row-level security policy. DATABASE_URL_UNPOOLED is for migrations only, never for request traffic.
# SENTRAPEDIA_DATABASE_URL=
# SENTRAPEDIA_SYNC_MODE=off

# Analysis limits of the gated beta (Clerk auth mode only; the local mode runs without them). They are counted in
# the same database, so in Clerk mode SENTRAPEDIA_DATABASE_URL is required for analyses whatever the sync mode is.
# Daily analyses per person, a whole number from 1 to 9999. PLACEHOLDER: no default exists and analyses are refused
# (503 QUOTA_NOT_SET) until Gaffer sets it. Formula: daily budget / (average cost per analysis x daily active users).
# SENTRAPEDIA_USER_DAILY_ANALYSES=

# Private data folder (2026-11-18): theoracle/index/, oracle/sentrapedia.json and aadi/service/data/icd10.json at the
# same relative paths as in the capsule. Not in the public repository. Default: the working folder.
# SENTRAPEDIA_DATA_DIR=
# Marketing site contact form (apps/site/scripts/contact.mjs), set in the site deployment's environment. The
# endpoint stays unavailable without the Resend key and sender; production also needs the exact public origin.
# CONTACT_RECIPIENT overrides the default inbox.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# CONTACT_PUBLIC_ORIGIN=
# CONTACT_RECIPIENT=
# Operator and install switches, read from the environment of the command that uses them.
# `npm ci`: skip the Python engine install or the 1.2 GB model download (docs/architecture.md).
# SENTRAPEDIA_SKIP_AADI=1
# SENTRAPEDIA_SKIP_MODEL=1
# `npm run knowledge:push-server -- --yes`: the SSH target (user@host or a Host alias) and the data folder on
# the server (default /opt/sentrapedia/data).
# SENTRAPEDIA_SERVER=
# SENTRAPEDIA_SERVER_DATA_DIR=
# Leak guard (scripts/leak-guard.mjs): the folder holding the real private data to compare an exported public
# tree with, such as the backup.
# SENTRAPEDIA_LEAK_REFERENCE=
